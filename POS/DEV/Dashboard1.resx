  <data name="customSqlQuery2.Sql" xml:space="preserve">
    <value>begin
SELECT          dbo.Min_ACC.Name AS ACC,  SUM(dbo.min_flow.crid) AS debt, 
                         SUM(dbo.min_flow.debt) AS crdit,(SUM(dbo.min_flow.crid)-SUM(dbo.min_flow.debt))as Total
FROM            dbo.Min_ACC INNER JOIN
                         dbo.min_flow ON dbo.Min_ACC.id = dbo.min_flow.main_acc INNER JOIN
                         dbo.TBL_USERS ON dbo.min_flow.u_id = dbo.TBL_USERS.ID INNER JOIN
                         dbo.PAY ON dbo.Min_ACC.id = dbo.PAY.Min_ACC AND dbo.min_flow.ACC_id = dbo.PAY.id
						 where year(date) =YEAR(@year)
GROUP BY dbo.Min_ACC.Name
end 
begin

SELECT m.Name as "الحساب" 
      ,sum([R_cash]) as r_cash
      ,Sum([S_cash]) as s_cash
      ,sum([crid]) as c_crdt
	  ,sum([debt]) as c_deby

	   ,(sum([R_cash])+sum([crid])) as "جملة الوارد"
      ,(Sum([S_cash])+sum([debt])) as "جملة المنصرف"


  FROM [M_T_Log] tl
  inner join Min_ACC m on tl.a_id=m.id
  inner join min_flow mf on mf.main_acc=m.id
   where year(tl.date ) =YEAR(@year) or year(mf.JDate )=YEAR(@year)
  GROUP BY m.Name
end

begin

SELECT sum ( f.Debt-f.Credit) as 'To'
	  ,o.val1 as 'sh'
	 -- ,pay.name pay
	  
  FROM [dbo].[Cash_floow] f
inner join TBL_USERS u on u.ID=f.u_id
inner join PAY on pay.id=f.Type
inner join options o on o.o_id=f.shift and g_id ='sh'
--where   f.date between @date1 and @date2
where year(date) =YEAR(@year)
group by val1,o.o_id
order by o.o_id asc

end
begin

SELECT        TOP (5) LABEL_PRODUCT as LBL, SUM(ORDERS_DETAILS.QTE) AS QUT
FROM            ORDERS_DETAILS INNER JOIN
                         PRODUCTS ON ORDERS_DETAILS.ID_PRODUCT = PRODUCTS.ID_PRODUCT
						 inner join ORDERS o on o.ID_ORDER=ORDERS_DETAILS.ID_ORDER
						 where year(o.DATE_ORDER) =YEAR(@year)
GROUP BY PRODUCTS.LABEL_PRODUCT
ORDER BY QUT DESC

end

begin

SELECT      p.Name as ty, sum( Debt) as 'debt',sum( Credit) as 'crdt'
FROM          Cash_floow

inner join pay p on p.id=Type
where year(date) =YEAR(@year)
group by Name
--where year (date)=YEAR( convert(date, getdate()))

end</value>
